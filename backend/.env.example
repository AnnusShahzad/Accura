# =============================================================================
# Accura Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values. Anything left empty falls
# back to config.yaml.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_WORKERS=1
APP_FRONTEND_URL=http://localhost:3000
# Comma-separated origins allowed to call the API, or * for any
APP_CORS_ORIGINS=http://localhost:3000

# Hosting platforms usually provide these two; they take precedence
# PORT=10000
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Database: "sqlite" (local dev, no setup) or "postgres"
DB_ENGINE=sqlite
DB_SQLITE_PATH=accura_dev.db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accura
DB_USER=accura
DB_PASSWORD=changeme

# Redis (optional). Required for consistent rate limits across workers.
REDIS_URL=

# JWT – generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Secret for encrypting stored API keys (REQUIRED). Any long random string
# works; a Fernet key is used as-is. For example:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# SMTP (OTP codes, password reset, notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme
SMTP_FROM_NAME=Accura
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true

# Platform AI provider keys (users can also bring their own keys)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Any OpenAI-compatible endpoint (vLLM, Ollama, OpenRouter, NVIDIA NIM, ...)
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=

# Defaults used when a request doesn't name a provider/model
DEFAULT_AI_PROVIDER=openai
DEFAULT_GENERATOR_MODEL=gpt-5.2
DEFAULT_EVALUATOR_MODEL=gpt-5.1
DEFAULT_REPROMPT_MODEL=gpt-5.1

# Google Programmable Search (web search). Search is skipped when empty.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Stripe. Leave empty for demo billing (upgrades apply instantly, no charge).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Access control (see DEPLOYMENT.md for a public-demo setup)
REGISTRATION_ENABLED=true
GUEST_ENABLED=false
GUEST_TTL_HOURS=24
GUEST_REQUESTS_PER_MINUTE=5
GUEST_REQUESTS_PER_DAY=30
GUEST_MAX_ITERATIONS=3
GUEST_SIGNUPS_PER_HOUR=60
# Admin created/updated on startup (useful where you have no shell)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to false on any public server: user-supplied MCP/endpoint/webhook
# URLs may then not point at private or local network addresses
ALLOW_PRIVATE_URLS=true

# Company / Branding
COMPANY_NAME=Accura
COMPANY_LOGO_URL=https://example.com/logo.png
# Contact-form submissions are emailed here (empty = only stored)
SUPPORT_EMAIL=
