# =============================================================================
# Accura Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-secure-random-string
APP_WORKERS=1

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accura
DB_USER=accura
DB_PASSWORD=changeme
DB_POOL_SIZE=20

# Redis (for rate limiting & caching)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption key for storing user API keys (Fernet)
ENCRYPTION_KEY=generate-with-cryptography-fernet

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme
SMTP_FROM_NAME=Accura
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true

# Default AI Provider Keys (platform-level)
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# Google Search API
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Stripe (Billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Company / Branding
COMPANY_NAME=Accura
COMPANY_LOGO_URL=https://example.com/logo.png
