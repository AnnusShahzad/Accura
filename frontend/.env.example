# Option A (recommended for Vercel/Render): call the API directly.
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com/api/v1

# Option B: leave NEXT_PUBLIC_API_URL unset and the app proxies its own
# /api/v1 to BACKEND_URL (no CORS setup needed). Default shown.
BACKEND_URL=http://localhost:8000

# Both are read at build time: rebuild after changing them.
